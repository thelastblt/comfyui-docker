name: Publish on ComfyUI release

on:
  release:
    types: [published]
    repositories:
      - Comfy-Org/ComfyUI

concurrency:
  group: build-release
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write        # allows GITHUB_TOKEN to push to GHCR — no other secrets needed
    steps:
      - uses: actions/checkout@v4

      # ComfyUI tags releases as "v0.43.2"; the Dockerfile expects the version without the v
      - name: Extract version
        id: ver
        run: |
          tag="${{ github.event.release.tag_name }}"
          echo "ref=$tag" >> "$GITHUB_OUTPUT"
          echo "version=${tag#v}" >> "$GITHUB_OUTPUT"

      # Only build for real release tags (skips prerelease/odd tags)
      - name: Validate tag
        run: |
          echo "${{ steps.ver.outputs.ref }}" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$' || {
            echo "Skipping unexpected tag: ${{ github.event.release.tag_name }}"
            exit 1
          }

      - uses: docker/setup-buildx-action@v3

      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # Build first WITHOUT pushing, so broken releases never become :latest
      - name: Build
        uses: docker/build-push-action@v6
        with:
          context: .
          push: false
          load: true
          tags: ghcr.io/${{ github.repository_owner }}/comfyui-docker:${{ steps.ver.outputs.ref }}
          build-args: |
            COMFYUI_VERSION=${{ steps.ver.outputs.version }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # Smoke test: must boot and serve HTTP before publishing
      - name: Smoke test
        run: |
          docker run -d --name smoke -p 8188:8188 \
            ghcr.io/${{ github.repository_owner }}/comfyui-docker:${{ steps.ver.outputs.ref }} --cpu
          for i in $(seq 1 30); do
            sleep 10
            curl -fsS http://localhost:8188/ >/dev/null && { echo "Server is up"; exit 0; }
          done
          docker logs smoke; exit 1
          docker rm -f smoke
      - name: Push (versioned tag + latest)
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ghcr.io/${{ github.repository_owner }}/comfyui-docker:${{ steps.ver.outputs.ref }}
            ghcr.io/${{ github.repository_owner }}/comfyui-docker:latest
          build-args: |
            COMFYUI_VERSION=${{ steps.ver.outputs.version }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
